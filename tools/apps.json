{
  "hub": "splitwave-hub.exe",
  "apps": [
    {
      "id": "splitwave",
      "name": "Splitwave",
      "description": "유튜브 음원 다운로드와 키 조정",
      "exe": "splitwave.exe",
      "parts": [
        {
          "id": "app",
          "file": "splitwave.exe"
        }
      ]
    },
    {
      "id": "splitwave-full",
      "name": "Splitwave + 스템 분리",
      "description": "다운로드, 키 조정, 악기별 분리",
      "exe": "splitwave-full/splitwave-full.exe",
      "parts": [
        {
          "id": "torch",
          "file": "splitwave-full-torch.zip"
        },
        {
          "id": "model",
          "file": "splitwave-full-model.zip"
        },
        {
          "id": "app",
          "file": "splitwave-full-app.zip"
        },
        {
          "id": "runtime",
          "file": "splitwave-full-runtime.zip"
        }
      ],
      "split": {
        "source": "splitwave-full.zip",
        "parts": [
          {
            "id": "torch",
            "patterns": [
              "splitwave-full/_internal/torch/*",
              "splitwave-full/_internal/numpy/*",
              "splitwave-full/_internal/numpy.libs/*"
            ]
          },
          {
            "id": "model",
            "patterns": [
              "splitwave-full/_internal/hf_home/*"
            ]
          },
          {
            "id": "app",
            "patterns": [
              "splitwave-full/splitwave-full.exe",
              "splitwave-full/_internal/base_library.zip",
              "splitwave-full/_internal/*.dist-info/*"
            ]
          },
          {
            "id": "runtime",
            "patterns": [
              "*"
            ]
          }
        ]
      }
    },
    {
      "id": "tempofollow",
      "name": "Tempo Follow (실험)",
      "description": "드럼 템포를 따라가며 곡을 재생",
      "exe": "tempofollow/tempofollow.exe",
      "parts": [
        {
          "id": "all",
          "file": "tempofollow.zip"
        }
      ]
    }
  ]
}
